*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Drift exports and the editable Drift project are stored as normal git files
# (each file is under GitHub's 100 MB limit), not Git LFS.
Ranger_Video_Kit/exports/*.mp4 -filter -diff -merge
Ranger_Video_Kit/drift_project/**/*.mp4 -filter -diff -merge
Ranger_Video_Kit/drift_project/**/*.mkv -filter -diff -merge
Ranger_Video_Kit/drift_project/**/*.wav -filter -diff -merge
Ranger_Video_Kit/drift_project/*.drift -filter -diff -merge
